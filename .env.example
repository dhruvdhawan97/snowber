# Copy to .env and fill in. Never commit .env.

# ── Database (PostgreSQL 14+ running locally)
DATABASE_URL="postgresql://snowber:snowber@localhost:5432/snowber"

# ── Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# ── Cloud storage (before/after job photos)
# local = files under ./.storage served by this app with signed URLs (development)
# s3    = AWS S3, Cloudflare R2, DigitalOcean Spaces or MinIO
STORAGE_DRIVER="local"
# Leave S3_ENDPOINT empty for AWS S3. R2: https://<account-id>.r2.cloudflarestorage.com
# S3_ENDPOINT="https://tor1.digitaloceanspaces.com"
# S3_REGION="us-east-1"
# S3_BUCKET="snowber-photos"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Set to "true" for MinIO and other servers that need path-style URLs
# S3_FORCE_PATH_STYLE="false"
# Browsers upload straight to the bucket, so it needs a CORS rule like:
#   [{"AllowedOrigins":["http://localhost:3000","https://your-app.example"],
#     "AllowedMethods":["PUT","GET"],"AllowedHeaders":["Content-Type"],"MaxAgeSeconds":3000}]
# Keep the bucket private: the app hands out short-lived presigned URLs.
# Optional: separate secret for local signed URLs (defaults to BETTER_AUTH_SECRET)
# STORAGE_SIGNING_SECRET=""

# ── Geocoding (OpenStreetMap Nominatim, max 1 request/second)
# nominatim = real lookups; mock = deterministic positions around the neighborhood (offline/tests)
GEOCODER="nominatim"
NOMINATIM_USER_AGENT="Snowber/1.0 (student course project)"
GEOCODER_COUNTRY_CODES="ca"

# ── App
NEXT_PUBLIC_APP_TIMEZONE="America/Toronto"
NEXT_PUBLIC_NEIGHBORHOOD_LAT="43.6655"
NEXT_PUBLIC_NEIGHBORHOOD_LNG="-79.4115"
# Shows one-click demo account buttons on the sign-in page (development only)
NEXT_PUBLIC_DEMO_LOGINS="true"

# ── Payments (Stripe TEST mode)
# Leave empty to keep simulated payments. With a test key, homeowners pay on a
# Stripe Checkout page with card, Apple Pay or Google Pay (switch the wallets on in
# Dashboard → Settings → Payment methods). Test card: 4242 4242 4242 4242.
STRIPE_SECRET_KEY=""
# Printed by: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# Protects POST /api/cron/auto-confirm (24-hour auto-confirmation). Use a long random
# value (openssl rand -base64 32); the placeholder below is refused.
CRON_SECRET="replace-me"

# Optional OSRM routing service (falls back to nearest-neighbor when unavailable)
OSRM_BASE_URL=http://localhost:5001
